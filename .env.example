# Copy to .env.local and fill in. Never commit .env.local.

# ── Database ────────────────────────────────────────────────────────────────
# Local: `docker compose up -d` (or any MongoDB 6+). Production: e.g. MongoDB Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017/pulse

# ── Auth (Auth.js v5) ───────────────────────────────────────────────────────
# Encrypts session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
# Authorised redirect URI: <your origin>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Required when running `next start` yourself (locally or behind a proxy) rather than on Vercel.
AUTH_TRUST_HOST=true

# One-click "Continue as dev user" sign-in for local work and e2e tests.
# NEVER set this to true in production.
AUTH_DEV_LOGIN=true

# ── Reminders: Web Push (VAPID) ─────────────────────────────────────────────
# Generate a key pair once with:  npx web-push generate-vapid-keys
# Without them, reminders still reach the notification centre, but no push is sent.
# Changing the keys invalidates every device's subscription (each must turn notifications on again).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for push services: mailto: with a real address, or an https URL you own.
# Apple's push service rejects placeholders such as mailto:you@localhost.
VAPID_SUBJECT=

# ── Reminder worker ─────────────────────────────────────────────────────────
# `npm run worker` sends due reminders (every 20 s) and logs overdue tasks (every minute).
# Hosts without a long-running process can call GET /api/cron/tick every minute instead,
# with the header `Authorization: Bearer <CRON_SECRET>`. Leave empty to disable that route.
# Generate with: openssl rand -base64 32
CRON_SECRET=
